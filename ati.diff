-            return qdev_get_gpio_in(DEVICE(&a->intc[idx].orgates[or_idx]),
-                                    ast2700_ssp_intcmap[i].ptr[dev]);
-        }
-    }
-
-    return qdev_get_gpio_in(DEVICE(&a->armv7m), sc->irqmap[dev]);
-}
